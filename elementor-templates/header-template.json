              "settings": {
                "html": "\n<!-- Industrial Top Bar (Address, Phone, WhatsApp only) -->\n<div class=\"bg-slate-900 border-b border-slate-800 text-slate-300 text-xs py-2.5\">\n    <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-wrap justify-between items-center gap-3\">\n        <div class=\"flex items-center gap-6\">\n            <span class=\"inline-flex items-center gap-2\">\n                <i data-lucide=\"map-pin\" class=\"w-3.5 h-3.5 text-gold-500\"></i>\n                <span class=\"font-medium text-slate-200\">8500 Rue Saint-Patrick, LaSalle, QC H8N 1V1, Canada</span>\n            </span>\n            <span class=\"hidden md:inline-flex items-center gap-2\">\n                <i data-lucide=\"clock\" class=\"w-3.5 h-3.5 text-gold-500\"></i>\n                <span>Dock Receiving: Mon-Fri 06:30 - 17:00 EST</span>\n            </span>\n        </div>\n        <div class=\"flex items-center gap-6\">\n            <a href=\"tel:+15148783200\" class=\"inline-flex items-center gap-2 text-slate-300 hover:text-gold-400 transition-colors\">\n                <i data-lucide=\"phone\" class=\"w-3.5 h-3.5 text-gold-500\"></i>\n                <span class=\"font-mono font-medium\">+1 (514) 878-3200</span>\n            </a>\n            <a href=\"https://wa.me/15148783200\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded bg-emerald-950/80 border border-emerald-700/80 text-emerald-400 font-mono font-bold hover:bg-emerald-900 transition-colors\">\n                <i data-lucide=\"message-square\" class=\"w-3.5 h-3.5\"></i>\n                <span>WhatsApp Desk</span>\n            </a>\n        </div>\n    </div>\n</div>\n\n<!-- Main Sticky Navigation Bar -->\n<header class=\"sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-sm transition-all duration-200\">\n    <div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div class=\"flex items-center justify-between h-20\">\n            <!-- Brand Logo -->\n            <a href=\"/\" class=\"flex items-center gap-3 group\">\n                <img src=\"/wp-content/themes/montreal-polymers-theme/assets/images/logo yellow.svg\" alt=\"Montreal Polymers\" class=\"h-10 w-auto object-contain\" onerror=\"this.src='/wp-content/themes/montreal-polymers-theme/assets/images/logo-yellow.svg'\">\n            </a>\n\n            <!-- Desktop Navigation Links -->\n            <nav class=\"hidden lg:flex items-center gap-8 text-sm font-semibold text-slate-700\">\n                <a href=\"#home\" class=\"hover:text-gold-600 transition-colors\">Home</a>\n                <a href=\"#philosophy\" class=\"hover:text-gold-600 transition-colors\">Zero-Chemicals</a>\n                <a href=\"#services\" class=\"hover:text-gold-600 transition-colors\">Services</a>\n                <a href=\"#scrap-logistics\" class=\"hover:text-gold-600 transition-colors\">Scrap Buying</a>\n                <a href=\"#pvc\" class=\"hover:text-gold-600 transition-colors\">PVC Regrind</a>\n                <a href=\"#calculator\" class=\"hover:text-gold-600 transition-colors\">Landfill ROI</a>\n            </nav>\n\n            <!-- Actions & CTA Buttons -->\n            <div class=\"hidden sm:flex items-center gap-3\">\n                <a href=\"#contact\" class=\"px-5 py-2.5 rounded-lg text-xs font-bold uppercase tracking-wider text-slate-900 bg-gold-500 hover:bg-gold-400 transition-colors shadow-sm flex items-center gap-2\">\n                    <i data-lucide=\"file-spreadsheet\" class=\"w-4 h-4\"></i>\n                    <span>Request RFQ</span>\n                </a>\n            </div>\n        </div>\n    </div>\n</header>\n"
              },
